# Copy to .env for local development:   cp .env.example .env
# On a server, set these as real environment variables instead of using a file.

# Supabase Postgres connection string.
#
# Use the CONNECTION POOLER host (IPv4-reachable), NOT db.<project-ref>.supabase.co.
# Direct connections are IPv6-only now and fail with
# "getaddrinfo ENOTFOUND db.<ref>.supabase.co" on IPv4-only hosts.
#
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Format: postgresql://postgres.<ref>:<url-encoded-password>@<pooler-host>:5432/postgres
# (url-encode the password: @ -> %40, * -> %2A, ^ -> %5E, ...)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

PORT=3001
HOST=0.0.0.0
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

# Required. Signs session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-64-char-string

SESSION_TTL_MS=2592000000

# Optional pool tuning
# PG_POOL_MAX=10
# PG_CONNECTION_TIMEOUT_MS=10000
